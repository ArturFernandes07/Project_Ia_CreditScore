#Converte os elementos da coluna de crédito_por_ano em valores numéricos:
def parse_credit_history_age(age_str):
    if pd.isna(age_str):
        return np.nan
    try:
        # Remove any non-numeric characters and then split
        parts = str(age_str).replace('years', '').replace('and', '').replace('months', '').split()
        years = int(parts[0]) if parts else 0
        months = int(parts[1]) if len(parts) > 1 else 0
        return years * 12 + months # Convert to total months
    except:
        return np.nan

# Apply the function to 'Credit_History_Age'
